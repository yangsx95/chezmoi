# ~/.zshrc
# oh-my-zsh 配置文件

# -------------- 基础配置 --------------

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="ys"

# 仅加载常用插件；缺失的外部插件不会产生启动警告。
plugins=(git)
for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    if [[ -f "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$plugin/$plugin.plugin.zsh" ]]; then
        plugins+=("$plugin")
    fi
done
unset plugin

# -------------- 环境变量 --------------

# 编辑器设置
export EDITOR='vim'
export VISUAL='vim'

# 语言设置
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# 路径设置
typeset -U path
path=("$HOME/.local/bin" "$HOME/bin" $path)

# -------------- 常用别名 --------------

# 基础命令别名
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# 安全操作
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# 目录操作
alias mkdir='mkdir -p'

# 系统相关
if command -v htop &>/dev/null; then alias top='htop'; fi
if command -v free &>/dev/null; then alias free='free -h'; fi
alias df='df -h'
alias du='du -h'

# Git 别名
alias g='git'
alias ga='git add'
alias gc='git commit'
alias gcm='git commit -m'
alias gp='git push'
alias gpu='git push origin $(git branch --show-current)'
alias gl='git log'
alias glog='git log --oneline --graph --decorate'
alias gs='git status'
alias gb='git branch'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gm='git merge'
alias gr='git reset'
alias gst='git stash'
alias gsp='git stash pop'

# 网络相关
alias ping='ping -c 5'
alias fastping='ping -c 100 -s.2'
if command -v ip &>/dev/null; then alias ip='ip -c'; fi
if command -v ifconfig &>/dev/null; then alias ifconfig='ifconfig -a'; fi

# 开发相关
alias py='python3'
alias pip='pip3'
alias npm='npm --no-fund'
alias pnpm='pnpm --no-fund'

# -------------- 其他设置 --------------

# 启用 ls 颜色（Linux/WSL 使用 --color=auto；macOS 使用 -G）
{{- if eq .chezmoi.os "darwin" }}
alias ls='ls -G'
{{- else }}
alias ls='ls --color=auto'
{{- end }}

# 启用自动 cd
setopt autocd

# 启用通配符扩展
setopt extendedglob

# 历史记录
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000
setopt append_history
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_verify
setopt share_history

# -------------- 加载配置 --------------

# 加载 oh-my-zsh
if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
fi

if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

# 加载本地配置
if [ -f ~/.zshrc.local ]; then
    source ~/.zshrc.local
fi

# 加载工作配置
if [ -f ~/.zshrc.work ]; then
    source ~/.zshrc.work
fi

# -------------- 结束配置 --------------
