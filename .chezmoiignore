# 文档和版本控制
README.md
.git/**
.chezmoistate

# 安装、测试和配置脚本
setup.sh
tests/
tests/**
.github/
.github/**
.idea/
.idea/**

# 系统文件
.DS_Store
desktop.ini

{{- if eq (index . "manage_maven_settings") false }}
