{{- if eq .chezmoi.os "windows" }}
# Windows：不部署 Unix / zsh / macOS 专用配置
.zshrc
.zprofile
.proxyrc
.vimrc
.inputrc
.bashrc
.config/pip/pip.conf
.config/gh/config.yml
.config/mise/config.toml
.config/dnscrypt-proxy
.config/sing-box/launchd
.docker/daemon.json
.local/bin/sing-box-managed
.local/bin/media-to-text
.local/libexec/sing-box-diagnostics.sh
.local/libexec/sing-box-launchd-install
.local/libexec/sing-box-log-limit
.local/libexec/sing-box-start-when-network-ready
{{- else }}
# 非 Windows（Linux / WSL / macOS）：不部署 Windows 专用
.local/bin/sing-box-managed.cmd
.local/libexec/sing-box-windows-managed.ps1
.local/libexec/sing-box-windows-prepare.mjs
.local/libexec/sing-box-windows-proxy.mjs
Documents/PowerShell/Microsoft.PowerShell_profile.ps1
Documents/WindowsPowerShell/Microsoft.PowerShell_profile.ps1
.wslconfig
AppData/Roaming/pip/pip.ini
{{- if ne .chezmoi.os "darwin" }}
# 非 macOS：不部署 launchd 和独立 DNS 过滤
.config/dnscrypt-proxy
.config/sing-box/launchd
.local/libexec/sing-box-launchd-install
.local/libexec/sing-box-log-limit
