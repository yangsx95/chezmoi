{
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-direct"{{ if eq .chezmoi.os "darwin" }},
        "bind_interface": "en0"{{ end }}
      }
    ]
  },
  "route": {
    "rules": [
      {
        "network": [
          "tcp",
          "udp"
        ],
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "network": [
          "tcp",
          "udp"
        ],
        "port": 853,
        "action": "reject"
      },
      {
        "action": "sniff"
      }
    ]
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "auto_route": true,
      "strict_route": true,
      "endpoint_independent_nat": true,
      "address": [
        "198.18.0.1/30"
      ]
    }
  ]
}
