#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
config_dir="$config_home/sing-box/config.d"
data_dir="$data_home/sing-box"
rules_dir="$data_dir/rules"
sources_dir="$data_dir/sources"
generated_dir="$data_dir/generated"
private_config="$data_dir/private/10-outbounds.json"
base_config="$config_dir/00-base.json"
route_config="$generated_dir/20-route.json"
safe_search_config="$generated_dir/30-safe-search.json"
safe_search_generator="$HOME/.local/libexec/sing-box-safe-search-generate.mjs"
subscriptions_config="$config_home/sing-box/rule-subscriptions.json"
rules_config_dir="$config_home/sing-box/rules.d"
browser_security_profile="$config_home/sing-box/browser-security.mobileconfig"
source_parser="$HOME/.local/libexec/sing-box-rule-source-compile.mjs"
dnscrypt_blocklist="$config_home/dnscrypt-proxy/blocked-names.txt"
dnscrypt_allowlist="$config_home/dnscrypt-proxy/allowed-names.txt"
launchd_label="com.yangshunxiang.sing-box"
launchd_plist="/Library/LaunchDaemons/$launchd_label.plist"

usage() {
  printf '%s\n' 'Usage: sing-box-managed <compile|update|dns-sync|check|run [-d]|stop|restart|status|browser-security|browser-security-status>' '' \
    '  compile  Download and compile all enabled category rules' \
    '  update   Alias for compile' \
    '  dns-sync Refresh the independent dnscrypt-proxy local blocklist' \
    '  check    Verify the compiled sing-box configuration' \
    '  run      Check, then run sing-box with administrator privileges' \
    '           Use -d to keep it running after this command exits' \
    '  stop     Stop the running sing-box process' \
    '  restart  Stop, verify, and start sing-box in the background' \
    '  status   Show service status, uptime, and memory usage' \
    '  browser-security         Open the managed browser DNS security profile installer' \
    '  browser-security-status  Show managed browser DNS security settings'
}

require_command() { command -v "$1" >/dev/null 2>&1 || { printf 'Missing required command: %s\n' "$1" >&2; exit 1; }; }
require_file() { [ -f "$1" ] || { printf 'Missing required file: %s\n' "$1" >&2; exit 1; }; }
cleanup_dir() { [ -d "$1" ] && find "$1" -depth -delete; }
sing_box_pid() { pgrep -x sing-box | head -n 1 || true; }
sing_box_running() { pgrep -x sing-box >/dev/null 2>&1; }
launchd_loaded() { launchctl print "system/$launchd_label" >/dev/null 2>&1; }

cleanup_old_releases() {
  [ -d "$data_dir/rules-releases" ] || return
  active_release=$(readlink "$rules_dir" 2>/dev/null || true)
  [ -n "$active_release" ] || return
  find "$data_dir/rules-releases" -mindepth 1 -maxdepth 1 -type d | while IFS= read -r release; do
    [ "$release" = "$active_release" ] || cleanup_dir "$release"
  done
}

publish_rules() {
  candidate_path=$1
  releases_dir="$data_dir/rules-releases"
  release_path="$releases_dir/$(date +%s)-$$"
  next_link="$data_dir/.rules-next-$$"
  mkdir -p "$releases_dir"
  mv "$candidate_path" "$release_path"
  ln -s "$release_path" "$next_link"

  if [ -L "$rules_dir" ]; then
    # BSD mv needs -h to replace a symlink rather than move into its target;
    # GNU mv uses -T for the equivalent no-target-directory behavior.
    if ! mv -fh "$next_link" "$rules_dir" 2>/dev/null; then
      mv -fT "$next_link" "$rules_dir"
    fi
    return
  fi

  if [ -e "$rules_dir" ]; then
    legacy_path="$releases_dir/legacy-$(date +%s)-$$"
    mv "$rules_dir" "$legacy_path"
  fi
  mv "$next_link" "$rules_dir"
}

definition_files() {
  set -- "$rules_config_dir"/*.json
  [ -f "$1" ] || { printf 'No category rule files found in %s\n' "$rules_config_dir" >&2; exit 1; }
  printf '%s\n' "$@"
}

validate_definitions() {
  require_file "$subscriptions_config"
  files=$(definition_files)
  jq -e '
    .version == 1 and (.route.final | type == "string" and length > 0)
    and (.dns_rewrite.ttl | type == "number" and . >= 0 and . <= 86400)
    and (.dns_rewrite.suppress_local_discovery | type == "boolean")
    and ((.dns_rewrite.local_mappings // []) | type == "array"
      and all(.[]; (.domain | type == "string" and length > 0)
        and (.record_type == "CNAME" or .record_type == "A" or .record_type == "AAAA")
        and (.target | type == "string" and length > 0)))
  ' "$subscriptions_config" >/dev/null || { printf '%s\n' 'Invalid rule-subscriptions.json' >&2; exit 1; }
  # Shell word splitting is intentional: rule definition names may not contain spaces.
  set -- $files
  jq -e -s '
    length > 0
    and all(.[]; .version == 1 and (.category | type == "string" and length > 0) and (.rule_sets | type == "array" and length > 0))
    and ([.[] | .rule_sets[] | .tag] | length == (unique | length))
    and all(.[] | .rule_sets[];
      (.tag | type == "string" and test("^[a-z0-9][a-z0-9-]*$"))
      and (.name | type == "string" and length > 0)
      and (.enabled | type == "boolean")
      and (.sources | type == "array")
      and all(.sources[]; (.format == "hosts" or .format == "domain-list" or .format == "ip-list" or .format == "clash" or .format == "source" or .format == "adguard-dnsrewrite") and (.url | type == "string" and startswith("https://")))
      and (if .type == "route-rule" then (.priority | type == "number") and (.action == "block" or .action == "direct" or (.outbound | type == "string" and length > 0)) and (if has("dns_block") then (.dns_block | type == "boolean") else true end) and (.local_rules | type == "array") and all(.sources[]; .format != "adguard-dnsrewrite") elif .type == "dns-rewrite" then (.sources | length == 1) and .sources[0].format == "adguard-dnsrewrite" else false end)
    )
  ' "$@" >/dev/null || { printf '%s\n' 'Invalid rules.d category definition' >&2; exit 1; }
}

generate_route() {
  output_path=$1
  rule_path=${2:-"$rules_dir"}
  files=$(definition_files)
  set -- $files
  jq -s --arg rules "$rule_path" --slurpfile common "$subscriptions_config" --slurpfile private "$private_config" '
    def outbound: if .action == "block" then "block" elif .action == "direct" then "direct" else .outbound end;
    def route_rule: if .action == "block" then {rule_set:.tag,action:"reject"} else {rule_set:.tag,outbound:(outbound)} end;
    ([.[] | .rule_sets[] | select(.type == "route-rule" and .enabled) | {tag,priority,action,outbound,sources,dns_block:(if has("dns_block") then .dns_block else true end)}] | sort_by(.priority, .tag)) as $items
    | ($private[0].outbounds | map(.server? // empty | select(type == "string" and test("[A-Za-z]"))) | unique) as $proxy_endpoints
    | {route:{rules:([{domain:$proxy_endpoints,outbound:"direct"}] + [$items[] | select(.action == "block") | route_rule] + [{ip_version:6,outbound:$common[0].route.final}] + [$items[] | select(.action != "block") | route_rule]),rule_set:[$items[] | {type:"local",tag:.tag,format:"binary",path:($rules + "/" + .tag + ".srs")}],final:$common[0].route.final,auto_detect_interface:($common[0].route.auto_detect_interface // true)},dns:{rules:([{domain:$proxy_endpoints,action:"route",server:"dns-direct"}] + [$items[] | select(.action == "block" and .dns_block and all(.sources[]; .format != "ip-list")) | {rule_set:.tag,action:"reject"}])}}
  ' "$@" > "$output_path"
}

generate_safe_search_input() {
  output_path=$1
  files=$(definition_files)
  set -- $files
  jq -s --slurpfile common "$subscriptions_config" '
    $common[0] + {subscriptions:[.[] | .rule_sets[] | select(.type == "dns-rewrite") | . as $set | .sources[] | {type:"dns-rewrite",tag:$set.tag,name:$set.name,enabled:$set.enabled,format,url}]}
  ' "$@" > "$output_path"
}

generate_dnscrypt_blocklist() {
  [ "$(uname -s)" = Darwin ] || return
  oisd_source="$sources_dir/oisd-nsfw-0.source"
  require_file "$oisd_source"
  require_file "$private_config"
  mkdir -p "$(dirname "$dnscrypt_blocklist")"
  output="$dnscrypt_blocklist.next"
  files=$(definition_files); set -- $files
  {
    awk 'NF && $1 !~ /^#/ { print $1 }' "$oisd_source"
    jq -r -s '
      .[] | .rule_sets[]
      | select(.type == "route-rule" and .enabled and .action == "block")
      | .local_rules[]?
      | (.domain[]?, .domain_suffix[]?, (.domain_keyword[]? | "*" + . + "*"))
    ' "$@"
  } | awk 'NF && !seen[$0]++' > "$output"
  mv -f "$output" "$dnscrypt_blocklist"
  chmod 644 "$dnscrypt_blocklist"
  jq -r '.outbounds[] | .server? // empty | select(test("[A-Za-z]"))' "$private_config" \
    | awk 'NF && !seen[$0]++' > "$dnscrypt_allowlist.next"
  mv -f "$dnscrypt_allowlist.next" "$dnscrypt_allowlist"
  chmod 644 "$dnscrypt_allowlist"
  touch "$dnscrypt_blocklist" "$dnscrypt_allowlist"
  printf 'dnscrypt-proxy blocklist refreshed: %s entries\n' "$(wc -l < "$dnscrypt_blocklist" | tr -d ' ')"
}

compile_rules() {
  require_command curl; require_command jq; require_command node; require_command sing-box
  require_file "$base_config"; require_file "$private_config"; require_file "$source_parser"; require_file "$safe_search_generator"
  validate_definitions
  mkdir -p "$data_dir" "$generated_dir" "$sources_dir"
  work_dir=$(mktemp -d "$data_dir/.rules.XXXXXX")
  trap 'cleanup_dir "$work_dir"' EXIT HUP INT TERM
  candidate_rules="$work_dir/rules"; candidate_sources="$work_dir/sources"; mkdir -p "$candidate_rules" "$candidate_sources"
  definitions=$(definition_files)
  set -- $definitions
  jq -c -s '[.[] | .rule_sets[] | select(.type == "route-rule" and .enabled)] | sort_by(.priority, .tag)[]' "$@" |
  while IFS= read -r entry; do
    tag=$(printf '%s' "$entry" | jq -r '.tag')
    action=$(printf '%s' "$entry" | jq -r '.action')
    input_dir="$work_dir/$tag-input"; mkdir -p "$input_dir"
    printf '%s' "$entry" | jq '{version:4,rules:.local_rules}' > "$input_dir/00-local.json"
    source_count=$(printf '%s' "$entry" | jq '.sources | length')
    index=0
    while [ "$index" -lt "$source_count" ]; do
      source=$(printf '%s' "$entry" | jq -c ".sources[$index]")
      format=$(printf '%s' "$source" | jq -r '.format')
      url=$(printf '%s' "$source" | jq -r '.url')
      raw_file="$candidate_sources/$tag-$index.source"
      json_file="$input_dir/$(printf '%02d' $((index + 1)))-source.json"
      printf '[%s] downloading %s\n' "$tag" "$url"
      curl --fail --location --silent --show-error --retry 3 --retry-all-errors --connect-timeout 20 --max-time 300 --proto '=https' --user-agent 'chezmoi-sing-box-rules/1' --output "$raw_file" "$url"
      if [ "$format" = source ]; then cp "$raw_file" "$json_file"; else node "$source_parser" "$raw_file" "$format" "$json_file" "$action"; fi
      index=$((index + 1))
    done
    merged_file="$work_dir/$tag.json"
    sing-box rule-set merge "$merged_file" -C "$input_dir" >/dev/null
    sing-box rule-set compile --output "$candidate_rules/$tag.srs" "$merged_file"
    chmod 600 "$candidate_rules/$tag.srs"
  done
  safe_input="$work_dir/safe-search-input.json"; safe_sources="$work_dir/safe-search-sources"; safe_config="$work_dir/10-safe-search.json"
  mkdir -p "$safe_sources"; generate_safe_search_input "$safe_input"
  jq -c '.subscriptions[] | select(.enabled)' "$safe_input" | while IFS= read -r entry; do
    tag=$(printf '%s' "$entry" | jq -r '.tag'); url=$(printf '%s' "$entry" | jq -r '.url')
    printf '[safe-search/%s] downloading\n' "$tag"
    curl --fail --location --silent --show-error --retry 3 --retry-all-errors --connect-timeout 20 --max-time 300 --proto '=https' --user-agent 'chezmoi-sing-box-rules/1' --output "$safe_sources/$tag.source" "$url"
  done
  node "$safe_search_generator" "$safe_input" "$safe_config" "$safe_sources"
  candidate_route="$work_dir/20-route.json"; generate_route "$candidate_route" "$candidate_rules"
  sing-box check -c "$base_config" -c "$private_config" -c "$candidate_route" -c "$safe_config"
  final_route="$work_dir/20-route-final.json"; generate_route "$final_route"
  publish_rules "$candidate_rules"
  find "$sources_dir" -type f -name '*.source' -delete
  for file in "$candidate_sources"/*.source; do [ -f "$file" ] && mv -f "$file" "$sources_dir/$(basename "$file")"; done
  generate_dnscrypt_blocklist
  sing-box check -c "$base_config" -c "$private_config" -c "$final_route" -c "$safe_config"
  mv -f "$safe_config" "$safe_search_config"; mv -f "$final_route" "$route_config"
  cleanup_old_releases
  cleanup_dir "$work_dir"; trap - EXIT HUP INT TERM
  printf '%s\n' 'Category rules compiled and applied successfully.'
}

check_config() {
  require_command sing-box; require_file "$base_config"; require_file "$private_config"; require_file "$safe_search_config"; require_file "$route_config"
  validate_definitions
  definitions=$(definition_files); set -- $definitions
  jq -r -s '.[] | .rule_sets[] | select(.type == "route-rule" and .enabled) | .tag' "$@" | while IFS= read -r tag; do require_file "$rules_dir/$tag.srs"; done
  sing-box check -c "$base_config" -c "$private_config" -c "$route_config" -c "$safe_search_config"
}

run_sing_box() {
  background=${1:-}
  case "$background" in
    ''|-d|--background) ;;
    *) usage >&2; exit 2 ;;
  esac
  ensure_browser_security
  check_config
  if launchd_loaded; then
    if [ -z "$background" ]; then
      printf '%s\n' 'The sing-box launch service is loaded; stop it before a foreground run.' >&2
      exit 1
    fi
    if sing_box_running; then
      printf '%s\n' 'sing-box is already running under launchd'
    else
      printf '%s\n' 'sing-box launch service is waiting for network readiness'
    fi
    return
  fi
  if sing_box_running; then
    printf '%s\n' 'sing-box is already running; stop it before starting another instance.' >&2
    exit 1
  fi
  if [ -z "$background" ]; then
    exec sudo sing-box run -c "$base_config" -c "$private_config" -c "$route_config" -c "$safe_search_config"
  fi
  if [ -f "$launchd_plist" ]; then
    sudo launchctl bootstrap system "$launchd_plist"
    sleep 1
    launchd_loaded || { printf '%s\n' 'The sing-box launch service did not load.' >&2; exit 1; }
    if sing_box_running; then
      printf 'sing-box launch service started (PID %s).\n' "$(sing_box_pid)"
    else
      printf '%s\n' 'sing-box launch service loaded and is waiting for network readiness'
    fi
    return
  fi
  log_file="$data_dir/sing-box.log"
  sing_box_binary=$(command -v sing-box)
  sudo -b /bin/sh -c 'exec "$1" run -c "$2" -c "$3" -c "$4" -c "$5" >> "$6" 2>&1' sh \
    "$sing_box_binary" "$base_config" "$private_config" "$route_config" "$safe_search_config" "$log_file"
  sleep 1
  pid=$(sing_box_pid)
  if [ -z "$pid" ]; then
    printf 'sing-box did not stay running; inspect %s\n' "$log_file" >&2
    exit 1
  fi
  printf 'sing-box started in the background (PID %s). Log: %s\n' "$pid" "$log_file"
}

stop_sing_box() {
  if ! launchd_loaded && ! sing_box_running; then
    printf '%s\n' 'sing-box is not running'
    return
  fi

  if launchd_loaded; then
    sudo launchctl bootout "system/$launchd_label"
  else
    sudo pkill -x sing-box
  fi
  attempts=0
  while sing_box_running; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 5 ]; then
      printf '%s\n' 'sing-box did not stop cleanly; inspect the running process.' >&2
      exit 1
    fi
    sleep 1
  done
  printf '%s\n' 'sing-box stopped'
}

restart_sing_box() {
  ensure_browser_security
  if launchd_loaded; then
    check_config
    sudo launchctl kickstart -k "system/$launchd_label"
    sleep 1
    if sing_box_running; then
      printf 'sing-box launch service restarted (PID %s).\n' "$(sing_box_pid)"
    else
      printf '%s\n' 'sing-box launch service restarted and is waiting for network readiness'
    fi
    return
  fi
  stop_sing_box
  run_sing_box -d
}

status_sing_box() {
  pid=$(sing_box_pid)
  if launchd_loaded && [ -z "$pid" ]; then
    printf '%s\n' 'Service: waiting for network'
    printf '%s\n' 'Startup: enabled and managed by launchd'
    return
  fi
  [ -n "$pid" ] || { printf '%s\n' 'Service: not running'; [ ! -f "$launchd_plist" ] || printf '%s\n' 'Startup: installed but not loaded'; exit 1; }
  user=$(ps -p "$pid" -o user= | tr -d ' ')
  elapsed=$(ps -p "$pid" -o etime= | tr -d ' ')
  rss_kib=$(ps -p "$pid" -o rss= | tr -d ' ')
  memory_mib=$(awk -v rss_kib="$rss_kib" 'BEGIN { printf "%.1f MiB", rss_kib / 1024 }')
  printf '%s\n' 'Service: running'
  printf 'PID: %s\nUser: %s\nUptime: %s\nMemory: %s\n' "$pid" "$user" "$elapsed" "$memory_mib"
  if launchd_loaded; then
    printf '%s\n' 'Startup: enabled and managed by launchd'
  elif [ -f "$launchd_plist" ]; then
    printf '%s\n' 'Startup: installed; activates at next boot or background run'
  else
    printf '%s\n' 'Startup: not installed'
  fi
}

apply_browser_security() {
  require_command open; require_command plutil; require_file "$browser_security_profile"
  plutil -lint "$browser_security_profile" >/dev/null
  open "$browser_security_profile"
  printf '%s\n' 'Opened the browser DNS security profile installer.'
}

browser_security_installed() {
  require_command profiles
  profiles show -type configuration 2>/dev/null | grep -Fq 'profileIdentifier: com.yangshunxiang.singbox.browser-security'
}

ensure_browser_security() {
  if browser_security_installed; then
    return
  fi
  apply_browser_security
  printf '%s\n' 'Install the downloaded Chrome DNS security profile, then run this command again.' >&2
  exit 1
}

browser_security_status() {
  if browser_security_installed; then
    printf '%s\n' 'Browser security profile is installed'
  else
    printf '%s\n' 'Browser security profile is not installed'
  fi
}

case ${1:-} in
  compile|update) compile_rules ;;
  dns-sync) generate_dnscrypt_blocklist ;;
  check) check_config ;;
  run) run_sing_box "${2:-}" ;;
  stop) stop_sing_box ;;
  restart) restart_sing_box ;;
  status) status_sing_box ;;
  browser-security) apply_browser_security ;;
  browser-security-status) browser_security_status ;;
  *) usage >&2; exit 2 ;;
esac
