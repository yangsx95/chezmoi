" 基础设置
set fileencodings=utf-8,gbk,gb2312,cp936,latin1

" 显示设置
set number
set cursorline
set showmatch
set scrolloff=8
set laststatus=2
set showcmd
set showmode
set wrap
set linebreak

" 搜索设置
set ignorecase
set smartcase
set incsearch
set hlsearch

" 缩进设置
set tabstop=4
set softtabstop=4
set shiftwidth=4
set expandtab
set autoindent

" 文件设置
set autoread
set fileformats=unix,dos,mac

" 鼠标设置
set mouse=a

" 简单的颜色主题
colorscheme default
set background=dark

" 语法与文件类型
syntax on
filetype plugin indent on

" 快捷键映射
let mapleader=" "
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
